# SILP — Nginx تولید (PRD §12.1، NFR-03، M7-17)
#
# قالب envsubst تصویر nginx: فقط ${SILP_DOMAIN} و ${SILP_S3_ORIGIN} جایگزین
# می‌شوند (متغیرهای محیطی تعریف‌شده)؛ $host و بقیهٔ متغیرهای nginx دست نمی‌خورند.
#
# راه‌اندازی اولین گواهی (یک بار، پیش از بالا آوردن این پیکربندی کامل):
# docs/ops/runbook.md «گواهی TLS».

# محدودیت نرخ لبه — لایهٔ دوم پس از محدودیت نرخ اپ (§5.1).
limit_req_zone $binary_remote_addr zone=silp_auth:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=silp_api:10m rate=300r/m;

upstream silp_api {
    server api:8000;
    keepalive 32;
}

upstream silp_web {
    server web:3000;
    keepalive 32;
}

# ── ۸۰: فقط چالش ACME و تغییر مسیر ───────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${SILP_DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── ۴۴۳ ─────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SILP_DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${SILP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SILP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:silp_tls:10m;
    ssl_session_timeout 1d;

    # هدرهای امنیتی در فایل جدا: add_header در هر location که خودش هدر
    # بگذارد، همهٔ هدرهای سطح server را کنار می‌گذارد — پیش از M7-17
    # چانک‌های /_next/static بی HSTS و nosniff می‌رفتند.
    include /etc/nginx/conf.d/security-headers.inc;
    # Next.js همین هدرها را می‌گذارد (next.config.ts، برای توسعه)؛ بدون این
    # هر پاسخ دو نسخه داشت و مرجع واقعی این فایل است.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;

    client_max_body_size 64m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # ── IP واقعی کاربر ──────────────────────────────────────────────
    # هدر ورودی بازنویسی می‌شود تا کلاینت نتواند آن را جعل کند و
    # محدودیت نرخ به‌ازای IP را دور بزند.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;

    # ── سلامت ───────────────────────────────────────────────────────
    location = /health {
        proxy_pass http://silp_api;
        access_log off;
    }

    # معیارها فقط از شبکهٔ داخلی (Prometheus مستقیم به api:8000 می‌رود).
    location = /metrics {
        return 404;
    }

    # ── احراز هویت: محدودیت سخت‌تر ──────────────────────────────────
    location /api/v1/auth/ {
        limit_req zone=silp_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://silp_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location /api/ {
        limit_req zone=silp_api burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://silp_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # SSE مرکز اعلان (§5.10) نباید بافر شود.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # ── دارایی‌های ایستا ────────────────────────────────────────────
    location /_next/static/ {
        proxy_pass http://silp_web;
        proxy_hide_header Cache-Control;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /fonts/ {
        proxy_pass http://silp_web;
        proxy_hide_header Cache-Control;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=2592000" always;
    }

    location / {
        proxy_pass http://silp_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
