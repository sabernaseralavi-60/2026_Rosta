# SILP — نمونهٔ متغیرهای محیطی (PRD §12.7)
# این فایل در مخزن است و هیچ راز واقعی نباید در آن نوشته شود.
# برای توسعه: cp .env.example .env

# ── هسته ────────────────────────────────────────────────────────────────
ENVIRONMENT=development                  # development | test | production
SECRET_KEY=dev-only-change-me-0000000000000000000000000000000000000000000000
JWT_SECRET_KEY=dev-only-change-me-1111111111111111111111111111111111111111111
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOG_LEVEL=INFO

# ── دیتابیس ─────────────────────────────────────────────────────────────
POSTGRES_USER=silp
POSTGRES_PASSWORD=silp
POSTGRES_DB=silp
DATABASE_URL=postgresql+asyncpg://silp:silp@postgres:5432/silp
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=10000

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── ذخیره‌سازی (MinIO در توسعه، ابر آروان در تولید) ─────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=silp-dev
S3_ACCESS_KEY=silpminio
S3_SECRET_KEY=silpminio
S3_REGION=us-east-1
S3_PUBLIC_BASE=http://localhost:9000/silp-dev

# ── احراز هویت ──────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_RESEND_AFTER_SECONDS=60
OTP_MAX_ATTEMPTS=3
OTP_PER_DESTINATION_PER_10MIN=3
OTP_PER_IP_PER_HOUR=10
# فقط در ENVIRONMENT=development اثر دارد؛ در تولید نادیده گرفته می‌شود.
DEV_FIXED_OTP=111111

# ── پیامک ───────────────────────────────────────────────────────────────
SMS_PROVIDER=console                     # console | kavenegar
SMS_API_KEY=
SMS_SENDER=10008663
SMS_OTP_TEMPLATE=silp-otp

# ── ایمیل ───────────────────────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=noreply@silp.local

# ── پیام‌رسان‌ها (از M6 استفاده می‌شوند) ────────────────────────────────
TELEGRAM_BOT_TOKEN=
EITAA_API_TOKEN=
WHATSAPP_API_URL=

# ── رصد ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── محصول ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DEFAULT_TERM_CODE=1404-2
QUIET_HOURS_START=23
QUIET_HOURS_END=8

# ── فرانت‌اند (Next.js) ─────────────────────────────────────────────────
# مرورگر از طریق میزبان به API می‌رسد؛ رندر سمت سرور از شبکهٔ داخلی Docker.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://api:8000/api/v1
