# SILP — نمونهٔ متغیرهای محیطی (PRD §12.7)
# این فایل در مخزن است و هیچ راز واقعی نباید در آن نوشته شود.
# برای توسعه: cp .env.example .env

# ── هسته ────────────────────────────────────────────────────────────────
ENVIRONMENT=development                  # development | test | production
SECRET_KEY=dev-only-change-me-0000000000000000000000000000000000000000000000
JWT_SECRET_KEY=dev-only-change-me-1111111111111111111111111111111111111111111
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOG_LEVEL=INFO

# ── دیتابیس ─────────────────────────────────────────────────────────────
POSTGRES_USER=silp
POSTGRES_PASSWORD=silp
POSTGRES_DB=silp
DATABASE_URL=postgresql+asyncpg://silp:silp@postgres:5432/silp
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=10000

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── ذخیره‌سازی (MinIO در توسعه، ابر آروان در تولید) ─────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=silp-dev
S3_ACCESS_KEY=silpminio
S3_SECRET_KEY=silpminio
S3_REGION=us-east-1
S3_PUBLIC_BASE=http://localhost:9000/silp-dev

# ── کتابخانهٔ دروس (ADR-0008) ───────────────────────────────────────────
# پوشه‌ای که هر زیرپوشه‌اش یک درس است. مسیر نسبی یعنی نسبت به ریشهٔ مخزن.
# در داکر این پوشه روی /app/Courses سوار می‌شود (compose.dev.yml).
COURSES_DIR=Courses

# ── احراز هویت ──────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_RESEND_AFTER_SECONDS=60
OTP_MAX_ATTEMPTS=3
OTP_PER_DESTINATION_PER_10MIN=3
OTP_PER_IP_PER_HOUR=10
# فقط در ENVIRONMENT=development اثر دارد؛ در تولید نادیده گرفته می‌شود.
DEV_FIXED_OTP=111111

# ── پیامک ───────────────────────────────────────────────────────────────
SMS_PROVIDER=console                     # console | kavenegar
SMS_API_KEY=
SMS_SENDER=10008663
SMS_OTP_TEMPLATE=silp-otp
SMS_API_BASE=https://api.kavenegar.com/v1

# ── ایمیل ───────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp                      # console | smtp | disabled — در تولید smtp یا disabled
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=noreply@silp.local

# ── پیام‌رسان‌ها (M6، ADR-0013) ─────────────────────────────────────────
# disabled یعنی کانال به کاربر پیشنهاد نمی‌شود. console پیام را فقط لاگ می‌کند.
TELEGRAM_PROVIDER=disabled               # disabled | console | bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# تلگرام در ایران فیلتر است؛ این می‌تواند نشانی یک پروکسی بیرون از کشور باشد.
TELEGRAM_API_BASE=https://api.telegram.org
# رمز وب‌هوک: setWebhook(..., secret_token=همین) — بدون آن وب‌هوک ۴۰۴ می‌دهد.
TELEGRAM_WEBHOOK_SECRET=
EITAA_PROVIDER=disabled                  # disabled | console | eitaayar
EITAA_API_TOKEN=
EITAA_API_BASE=https://eitaayar.ir/api
# واتساپ آداپتور ندارد (ADR-0013).
# ── اعلان Push وب (ADR-0029) ────────────────────────────────────────────
# پیش‌فرض خاموش: سرویس Push کروم (FCM) از سرور ایران ممکن است در دسترس نباشد.
# کلیدها: python -m silp.scripts.gen_vapid_keys — عوض‌کردن کلید عمومی همهٔ اشتراک‌ها را بی‌اثر می‌کند.
PUSH_PROVIDER=disabled                   # disabled | console | webpush — در تولید webpush یا disabled
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@silp.ir
# فقط این میزبان‌ها (و زیردامنه‌هایشان) به‌عنوان نقطهٔ پایانی اشتراک پذیرفته می‌شوند (SSRF).
# PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,notify.windows.com

# ── صف ارسال (§7.10) ────────────────────────────────────────────────────
OUTBOX_BATCH_SIZE=50
OUTBOX_CONCURRENCY=8
MESSAGING_TIMEOUT_SECONDS=10

# ── رصد ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# M7-17 — Bearer برای /metrics. در تولید الزامی است (deploy.sh بدون آن
# متوقف می‌شود) و همان را برای Prometheus در infra/monitoring/secrets می‌نویسد.
METRICS_TOKEN=
# پورت معیارهای کارگر ARQ؛ ۰ یعنی خاموش.
WORKER_METRICS_PORT=9101

# ── تولید (compose.prod.yml، docs/ops/runbook.md) ───────────────────────
# دامنه برای nginx و گواهی TLS، و مبدأ فضای ذخیره‌سازی برای CSP (بارگذاری
# مستقیم مرورگر به S3).
SILP_DOMAIN=
SILP_S3_ORIGIN=
# پشتیبان بیرون از سرور — باکت جدا از باکت فایل‌ها (NFR-10).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1

# ── محصول ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DEFAULT_TERM_CODE=1404-2
QUIET_HOURS_START=23
QUIET_HOURS_END=8

# ── فرانت‌اند (Next.js) ─────────────────────────────────────────────────
# مرورگر از طریق میزبان به API می‌رسد؛ رندر سمت سرور از شبکهٔ داخلی Docker.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://api:8000/api/v1
